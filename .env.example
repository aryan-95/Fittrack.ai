# copy to .env
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Local dev (without docker server): 
DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack
# Web Push (generate with: npx web-push generate-vapid-keys). Optional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional SMTP for password-reset emails (otherwise the reset link is printed in server logs)
SMTP_URL=
